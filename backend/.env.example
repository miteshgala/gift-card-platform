# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
# Docker Compose default credentials — change in production
POSTGRES_USER=giftcard
POSTGRES_PASSWORD=secret
POSTGRES_DB=giftcard_db
DATABASE_URL=postgresql://giftcard:secret@localhost:5432/giftcard_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redissecret
REDIS_URL=redis://:redissecret@localhost:6379

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Must be at least 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=change_me_at_least_32_characters_long_jwt_secret
JWT_REFRESH_SECRET=change_me_at_least_32_characters_long_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption ──────────────────────────────────────────────────────────────
# Must be exactly 32 characters — generate with: openssl rand -hex 16
ENCRYPTION_KEY=change_me_exactly_32_chars_here!

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Use Mailtrap for dev, SES / Postmark / SendGrid for production
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@giftcards.example.com

# ─── Security ────────────────────────────────────────────────────────────────
MAX_PIN_ATTEMPTS=5
DEFAULT_CARD_EXPIRY_DAYS=365

# ─── API Key Prefixes ─────────────────────────────────────────────────────────
SANDBOX_KEY_PREFIX=sk_test_
LIVE_KEY_PREFIX=sk_live_

# ─── KYC / KYB ───────────────────────────────────────────────────────────────
# Cards with an initial balance >= this value (USD) are held PENDING until verified
KYC_THRESHOLD=1000
# HMAC secret used to verify incoming KYC webhook payloads (omit to skip in dev)
# KYC_WEBHOOK_SECRET=

# ─── Observability ───────────────────────────────────────────────────────────
# Sentry DSN — leave blank to disable error reporting (safe in dev/test)
# SENTRY_DSN=https://xxxxxxxxxxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (in addition to localhost in dev)
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ─── Frontend (docker-compose.prod.yml) ───────────────────────────────────────
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443
