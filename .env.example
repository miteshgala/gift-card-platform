# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=giftcard
POSTGRES_PASSWORD=giftcard_secret
POSTGRES_DB=giftcard_db
DATABASE_URL=postgresql://giftcard:giftcard_secret@localhost:5432/giftcard_db

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# ─── JWT ────────────────────────────────────────────────────────────────────
# Must be at least 32 characters
JWT_SECRET=change_me_in_production_jwt_secret_32chars
JWT_REFRESH_SECRET=change_me_in_production_refresh_32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption ─────────────────────────────────────────────────────────────
# AES-256 key — exactly 32 chars
ENCRYPTION_KEY=change_me_32_char_encryption_key_

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_pass
EMAIL_FROM=noreply@giftcards.example.com

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api/v1

# ─── Misc ────────────────────────────────────────────────────────────────────
# Max failed PIN attempts before 24hr lockout
MAX_PIN_ATTEMPTS=5
# Default card expiry in days
DEFAULT_CARD_EXPIRY_DAYS=365
# Sandbox API key prefix
SANDBOX_KEY_PREFIX=sk_test_
LIVE_KEY_PREFIX=sk_live_
