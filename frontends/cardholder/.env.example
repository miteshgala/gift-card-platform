# Cardholder portal environment variables
# Copy to .env.local for local development

# Stripe publishable key (safe to expose — not a secret)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# API base URL (Vite proxies /api → this in dev; nginx proxies in Docker)
VITE_API_BASE_URL=/api/v1

# App title (optional branding override)
VITE_APP_TITLE=My Gift Card
