# Worker Dockerfile
# Build context: ./services/api (docker-compose sets this)
# The worker imports shared modules from ../api/src — we compile api first.

# ─── Stage 1: Install API dependencies ────────────────────────────────────────
FROM node:22-alpine AS api-deps
WORKDIR /workspace/services/api
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts

# ─── Stage 2: Install Worker dependencies ─────────────────────────────────────
FROM node:22-alpine AS worker-deps
WORKDIR /workspace/services/worker

# Worker package.json is one level up in the repo — copy it in
COPY ../worker/package.json ./
RUN npm ci --ignore-scripts || npm install --ignore-scripts

# ─── Stage 3: Build ───────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
WORKDIR /workspace

# API
COPY . ./services/api
COPY --from=api-deps /workspace/services/api/node_modules ./services/api/node_modules
RUN cd services/api && npx prisma generate && npx tsc -p tsconfig.json

# Worker
COPY --from=worker-deps /workspace/services/worker/node_modules ./services/worker/node_modules

# ─── Stage 4: Production ──────────────────────────────────────────────────────
FROM node:22-alpine AS runner
WORKDIR /workspace

RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

COPY --from=builder --chown=nodejs:nodejs /workspace/services/api/dist ./services/api/dist
COPY --from=builder --chown=nodejs:nodejs /workspace/services/api/node_modules ./services/api/node_modules
COPY --from=builder --chown=nodejs:nodejs /workspace/services/api/src/prisma/schema.prisma ./services/api/src/prisma/schema.prisma

# Worker source (runs via tsx in production-like mode)
COPY --chown=nodejs:nodejs ../worker/src ./services/worker/src
COPY --from=builder --chown=nodejs:nodejs /workspace/services/worker/node_modules ./services/worker/node_modules

USER nodejs

# Use tsx for the worker (simpler than compiling separately, acceptable for worker)
CMD ["node", "--experimental-specifier-resolution=node", "/workspace/services/api/node_modules/.bin/tsx", "services/worker/src/scheduler.ts"]
