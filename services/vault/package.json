{
  "name": "@giftcard/vault",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "db:generate": "prisma generate --schema src/schema.prisma",
    "db:push": "prisma db push --schema src/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema src/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema src/schema.prisma"
  },
  "prisma": {
    "schema": "src/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "express": "^5.0.1",
    "helmet": "^8.0.0",
    "zod": "^3.24.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
